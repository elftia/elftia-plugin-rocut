{
  "name": "elftia-plugin-rocut",
  "version": "0.7.3",
  "private": true,
  "description": "Elftia app-extension packaging rocut as a host-managed Tool Host plus its agent skill, bundled CLI, wasm sibling, and prebuilt editor surface.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor-rocut.mjs",
    "build": "node scripts/build-dist.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "smoke:agent-cli": "node scripts/smoke-agent-cli.mjs",
    "test:portable-build": "node --test tests/portable-build-inputs.test.mjs tests/build-production-candidate.test.mjs",
    "build:production": "node scripts/build-production-candidate.mjs",
    "build:toolchain": "node scripts/prepare-production-toolchain.mjs",
    "promote:production": "node scripts/promote-production-candidate.mjs",
    "verify:production": "node scripts/promote-production-candidate.mjs --verify-only",
    "test:production-atomic": "node --test tests/production-promotion-atomic.test.mjs",
    "pack": "elftia-plugin pack dist/rocut --out release",
    "release": "elftia-plugin release dist/rocut --out release",
    "verify": "npm test && npm run verify:vendor && npm run build && npm run verify:dist"
  },
  "devDependencies": {
    "@elftia/plugin-kit": "0.2.1",
    "@types/node": "^24.7.0",
    "adm-zip": "0.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
